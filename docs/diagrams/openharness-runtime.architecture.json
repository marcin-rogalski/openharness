    {
      "dot": "cyan",
      "title": "Command / Event Loop",
      "items": [
        "UI clients send commands to the harness gateway",
        "Session runtime executes work as durable session actors",
        "Runtime emits events for progress, tools, approvals, and results",
        "UI clients subscribe to the same event stream"
      ]
    },
    {
      "dot": "emerald",
      "title": "Capability Plugins",
      "items": [
        "Tools, MCP servers, memory, and sandbox are adapters behind ports",
        "Built-in capabilities use the same plugin contract as external ones",
        "Agents and rules are declarative configuration, not execution engines"
      ]
    },
    {
      "dot": "violet",
      "title": "Process Model",
      "items": [
        "Target v1: one harness server process serves API, MCP, and built UI",
        "UI remains a separate client package and never executes agent logic",
        "Current two-service Docker Compose layout is transitional"
      ]
    }
