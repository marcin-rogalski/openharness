{
	"name": "openharness",
	"version": "0.1.0",
	"private": true,
	"workspaces": [
		"libs/*",
		"harness",
		"ui",
		"tests"
	],
	"scripts": {
		"build": "npm run build --workspaces --if-present",
		"run": "concurrently -n harness,ui -c blue,green \"npm run dev:server -w harness\" \"npm run dev -w @openharness/ui\"",
		"test": "npm run test:run --workspaces --if-present",
		"coverage": "npm run coverage --workspaces --if-present",
		"lint": "npm run lint --workspaces --if-present",
		"check": "npm run check -w @openharness/tests",
		"docker:build": "docker compose build",
		"docker:down": "docker compose down"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.1",
		"@types/node": "^24.12.4",
		"@vitest/coverage-v8": "^4.1.10",
		"concurrently": "^9.1.2",
		"tsup": "^8.3.0",
		"tsx": "^4.19.0",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10"
	}
}
